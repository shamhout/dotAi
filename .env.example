# Copy to ".env" for local builds that need absolute URLs. Never put secrets here:
# everything prefixed with VITE_ is public and ends up inside the built website.

# Public URL of the deployed site, WITHOUT a trailing slash.
#   GitHub Pages (project site): https://YOUR-USERNAME.github.io/YOUR-REPOSITORY
#   Custom domain later:         https://www.example.com
# The GitHub Actions workflow sets this automatically – you only need it for local production builds.
VITE_SITE_URL=

# Optional. Defaults to "./" (relative paths), which works at any URL path.
# Only set it if you want an absolute base, e.g. "/YOUR-REPOSITORY/".
VITE_BASE_PATH=
